cabal-version: 3.0
name: circuits-parser
version: 0.1.0.0
synopsis: Parser combinators for the circuits ecosystem
description:
  Parser combinators built on Circuit (core). Domain dialects (e.g.
  deck/card syntax) live as example cards under examples/, not as library
  modules.

license: BSD-3-Clause
author: Tony Day
maintainer: tonyday567@gmail.com
category: parsing
build-type: Simple
tested-with: ghc ==9.14.1

source-repository head
  type: git
  location: https://github.com/tonyday567/circuits-parser.git

library
  exposed-modules:
    Circuit.Parser
    Circuit.Stream
    Circuit.Parser.BranchingTraceProbe
    Circuit.Parser.Examples
    Circuit.Parser.LevelsT
    Circuit.Parser.Lexer
    Circuit.Parser.ProcessCompiler
    Circuit.Parser.ProcessProbe
    Circuit.Parser.Net
    Circuit.Parser.Primitives
    Circuit.Parser.Semiring
    Circuit.Parser.SemiringProbe
    Circuit.Parser.Syntax
    Circuit.Parser.Token
    Circuit.Parser.WeightedDiffProcess

  build-depends:
    base >=4.20 && <5,
    bytestring >=0.12.2 && <0.13,
    circuits >=0.3 && <0.4,
    containers >=0.8 && <0.9,
    deepseq >=1.5.1 && <1.6,
    harpie >=0.2 && <0.4,
    harpie-numhask >=0.2 && <0.3,
    logict >=0.8 && <0.9,
    process-stats >=0.1 && <0.2,
    mtl >=2.3 && <2.4,
    numhask >=0.14 && <0.15,
    numhask-diff >=0.1 && <0.2,
    text >=2.1.3 && <2.2,
    these >=1.2.1 && <1.3,

  hs-source-dirs: src
  default-language: GHC2024
  ghc-options:
    -Wall
    -Wcompat

benchmark circuits-parser-bench
  type: exitcode-stdio-1.0
  main-is: Bench.hs
  hs-source-dirs: bench
  build-depends:
    base >=4.20 && <5,
    attoparsec,
    bytestring >=0.12.2 && <0.13,
    circuits-parser,
    deepseq >=1.5.1 && <1.6,
    flatparse,
    megaparsec,
    mtl >=2.3 && <2.4,
    parsec,
    tasty-bench >=0.3 && <0.5,
    text >=2.1.3 && <2.2,
    these >=1.2.1 && <1.3,

  default-language: GHC2024
  ghc-options:
    -Wall
    -Wcompat
    -rtsopts
