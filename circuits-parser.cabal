cabal-version: 3.0
name: circuits-parser
version: 0.1.0.0
synopsis: Parser and markup for the circuits ecosystem
description:
  Parser combinators built on Circuit (core), plus an HTML/XML-ish markup
  pipeline (specialty). Domain dialects (e.g. deck/card syntax) live as
  example cards under examples/, not as library modules.

license: BSD-3-Clause
author: Tony Day
maintainer: tonyday567@gmail.com
category: parsing
build-type: Simple
tested-with: ghc ==9.14.1

source-repository head
  type: git
  location: https://github.com/tonyday567/circuits-parser.git

library
  exposed-modules:
    Circuit.Markup
    Circuit.Markup.Parse
    Circuit.Markup.Render
    Circuit.Markup.Tree
    Circuit.Markup.Types
    Circuit.Markup.Warn
    Circuit.Parser
    Circuit.Parser.Lexer
    Circuit.Parser.Primitives
    Circuit.Parser.Token
    Circuit.Parser.Unified
    Circuit.Parser.Unified.BranchingTraceProbe
    Circuit.Parser.Unified.Examples
    Circuit.Parser.Unified.Net
    Circuit.Parser.Unified.Semiring
    Circuit.Parser.Unified.SemiringProbe
    Circuit.Parser.Unified.MealyCompiler
    Circuit.Parser.Unified.MealyProbe
    Circuit.Parser.Unified.Syntax
    Circuit.Parser.Unified.WeightedDiffMealy

  build-depends:
    base >=4.20 && <5,
    bytestring >=0.12.2 && <0.13,
    circuits >=0.3 && <0.4,
    containers >=0.8 && <0.9,
    deepseq >=1.5.1 && <1.6,
    harpie >=0.2 && <0.4,
    logict >=0.8 && <0.9,
    mealy >=0.5 && <0.6,
    mtl >=2.3 && <2.4,
    numhask >=0.14 && <0.15,
    numhask-diff >=0.1 && <0.2,
    text >=2.1.3 && <2.2,
    these >=1.2.1 && <1.3,

  hs-source-dirs: src
  default-language: GHC2024
  ghc-options:
    -Wall
    -Wcompat

test-suite docspec
  type: exitcode-stdio-1.0
  main-is: Docspec.hs
  hs-source-dirs: test
  build-depends:
    base >=4.20 && <5,
    process >=1.6 && <1.7,

  default-language: GHC2024
  ghc-options:
    -Wall
    -Wcompat

benchmark circuits-parser-bench
  type: exitcode-stdio-1.0
  main-is: Bench.hs
  hs-source-dirs: bench
  build-depends:
    base >=4.20 && <5,
    attoparsec,
    bytestring >=0.12.2 && <0.13,
    circuits-parser,
    deepseq >=1.5.1 && <1.6,
    flatparse,
    megaparsec,
    mtl >=2.3 && <2.4,
    parsec,
    tasty-bench >=0.3 && <0.5,
    text >=2.1.3 && <2.2,
    these >=1.2.1 && <1.3,

  default-language: GHC2024
  ghc-options:
    -Wall
    -Wcompat
    -rtsopts
