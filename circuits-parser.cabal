cabal-version: 3.0
name: circuits-parser
version: 0.1.0.0
synopsis: Parser combinators for the circuits ecosystem
description:
  Parser combinators built on Circuit (core). Domain dialects (e.g.
  deck/card syntax) live as example cards under examples/, not as library
  modules.

license: BSD-3-Clause
author: Tony Day
maintainer: tonyday567@gmail.com
category: parsing
build-type: Simple
tested-with: ghc ==9.14.1
extra-doc-files: ChangeLog.md

source-repository head
  type: git
  location: https://github.com/tonyday567/circuits-parser.git

library
  exposed-modules:
    Circuit.Parser
    Circuit.Parser.Csv
    Circuit.Parser.Csv.Lexer
    Circuit.Parser.Examples
    Circuit.Parser.Json
    Circuit.Parser.Json.Lexer
    Circuit.Parser.Json.Unescape
    Circuit.Parser.Json.Value
    Circuit.Parser.Lexer
    Circuit.Parser.Primitives
    Circuit.Parser.ProcessCompiler
    Circuit.Parser.Syntax
    Circuit.Parser.Token
    Circuit.Stream

  build-depends:
    base >=4.20 && <5,
    bytestring >=0.11 && <0.13,
    circuits >=0.3 && <0.5,
    circuits-stats >=0.1 && <0.2,
    containers >=0.6 && <0.9,
    deepseq >=1.4 && <1.6,
    harpie >=0.2 && <0.4,
    mtl >=2.3 && <2.4,
    scientific >=0.3 && <0.4,
    text >=2.0 && <2.2,
    these >=1.2.1 && <1.3,
    vector >=0.12 && <0.14,

  hs-source-dirs: src
  default-language: GHC2024
  ghc-options:
    -Wall
    -Wcompat

benchmark circuits-parser-bench
  type: exitcode-stdio-1.0
  main-is: Bench.hs
  hs-source-dirs: bench
  build-depends:
    attoparsec,
    base >=4.20 && <5,
    bytestring >=0.11 && <0.13,
    circuits-parser,
    deepseq >=1.4 && <1.6,
    flatparse,
    megaparsec,
    mtl >=2.3 && <2.4,
    parsec,
    tasty-bench >=0.3 && <0.5,
    text >=2.0 && <2.2,
    these >=1.2.1 && <1.3,

  default-language: GHC2024
  ghc-options:
    -Wall
    -Wcompat
    -rtsopts

executable circuits-parser-axioma
  main-is: axioma.hs
  hs-source-dirs: app
  build-depends:
    base >=4.20 && <5,
    bytestring >=0.11 && <0.13,
    circuits-parser,
    scientific >=0.3 && <0.4,
    text >=2.0 && <2.2,
    vector >=0.12 && <0.14,

  default-language: GHC2024
  ghc-options:
    -Wall
    -Wcompat
